local function wss_test()
    with_server(echo_app(), function(port)
        local conn <close> = ws.connect(`wss://localhost:$port/echo`, { tls = { ca = TEST_CA }, timeout = 5 })
        conn:send("over TLS")
        assert(conn:receive() == "over TLS")
        local ok, err = catch ws.connect(`wss://localhost:$port/echo`, { tls = { ca = TEST_CA, servername = "other.test" } })
        assert(not ok and err:find("websocket: certificate verification failed for other.test", 1, true), err)
    end, { tls = { cert = TEST_CERT, key = TEST_KEY } })
end

local function refused_connection_test()
    local server = network.tcp.bind("127.0.0.1", 0)
    local _, port = server:getsockname()
    server:close()
    local ok, err = catch ws.connect(`ws://127.0.0.1:$port/echo`)
    assert(not ok and err:find("websocket: cannot connect to 127.0.0.1", 1, true), err)
end

local function receive_timeout_test()
    local app = web.app()
    local seen = {}
    app:get("/slow", ws.route(function(conn)
        local ok, err = catch conn:receive()
        seen.timeout = not ok and ws.iserror(err) and err.code
        -- The connection survives the timeout.
        conn:send("still here")
        seen.message = conn:receive()
    end, { timeout = 0.05 }))
    with_server(app, function(port)
        local conn <close> = ws.connect(`ws://127.0.0.1:$port/slow`, { timeout = 5 })
        assert(conn:receive() == "still here")
        conn:send("late")
        conn:receive()
    end)
    assert(seen.timeout == "timeout" and seen.message == "late")
end

local function lost_connection_test()
    -- A client whose server ends the stream without a close frame.
    local listener <close> = network.tcp.bind("127.0.0.1", 0)
    local _, port = listener:getsockname()
    local serving = coroutine.detach(coroutine.create(function()
        local sock <close> = listener:accept()
        local key
        repeat
            local line = vector.tostring(sock:receive("*l"))
            key = line:match("^Sec%-WebSocket%-Key: (.+)$") or key
        until line == ""
        sock:send("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
            .. `Sec-WebSocket-Accept: $(ws.accept_key(key))\r\n\r\n`)
    end))
    local conn <close> = ws.connect(`ws://127.0.0.1:$port/`)
    local message, code, reason = conn:receive()
    assert(message == nil and code == 1006 and reason == "connection closed", reason)
    coroutine.close(serving)
end
